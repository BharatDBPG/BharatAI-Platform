# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Cross-subdomain session handoff for sibling services (Vaarta).
# Every browser login also writes a `bharatai_token` cookie holding the same session JWT,
# scoped to this domain, so services under it can log the user in without a second
# sign-in. Defaults to '.bharatai.gov.in'; set to an empty string to disable.
# No need to change this for local development -- browsers discard a Domain cookie that
# doesn't match the serving host, so on localhost only `token` is used.
# The JWT grants full API access to the user's account and is sent to EVERY host under
# this domain, so only point it at a domain where every subdomain is trusted.
# BHARATAI_COOKIE_DOMAIN='.bharatai.gov.in'

# Strongly recommended alongside the above in production (both services are HTTPS):
# WEBUI_AUTH_COOKIE_SECURE=true

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
